# =============================================================
#  ここから下はプロジェクト固有の追記
#  （上のテンプレート部分は gitattributes/gitattributes から
#    再同期できるよう触らずに残しておくこと）
#  ※ 冒頭で定義済みの [attr]lfs マクロをそのまま利用している
#
#  Rev. 2026-08-23  監査反映
#    - *.framework / *.xcframework / *.bundle を **/…/** 形式に修正
#      （中間にスラッシュを含むパターンはリポジトリ直下にしか
#        マッチしないため、Assets/Plugins/iOS/*.framework/… が
#        LFS を素通りしていた。gitattributes はディレクトリに
#        マッチしても中のファイルへ再帰適用されない）
#    - *.bin / *.bytes / *.ktx を LFS に追加
#      （*.gltf の相棒バッファ、汎用バイナリ TextAsset 用）
#    - VFX Graph 系を unity-yaml に追加
#    - *.cs / シェーダ系に eol=lf を明示（改行方針の統一）
#    - ドットファイル指定を明示形に変更
# =============================================================

# -------------------------------------------------------------
# ネイティブプラグイン（iOS / macOS / Android 向けで必須）
#
#   .framework / .xcframework / .bundle は実体がディレクトリ。
#   先頭 **/ が無いとリポジトリ直下しか見ず、末尾 /** が無いと
#   中のファイルに届かない。両方が必須。
# -------------------------------------------------------------
*.dylib                 lfs
*.aar                   lfs
*.jar                   lfs
*.lib                   lfs
*.mdb                   lfs
**/*.bundle/**          lfs
**/*.framework/**       lfs
**/*.xcframework/**     lfs

# -------------------------------------------------------------
# 追加の3Dモデル形式
#   .gltf は外部バッファ .bin とセットで書き出されるため
#   .bin も併せて LFS に載せる
# -------------------------------------------------------------
*.glb                   lfs
*.gltf                  lfs
*.bin                   lfs
*.abc                   lfs
*.usd                   lfs
*.usda                  lfs
*.usdc                  lfs
*.usdz                  lfs
*.bvh                   lfs

# -------------------------------------------------------------
# 追加のテクスチャ / 音声 / 動画
# -------------------------------------------------------------
*.dds                   lfs
*.ktx                   lfs
*.ktx2                  lfs
*.psb                   lfs
*.flac                  lfs
*.webm                  lfs

# -------------------------------------------------------------
# 汎用バイナリ TextAsset
#   テンプレートの *.skel.bytes（Spine）を一般化したもの
# -------------------------------------------------------------
*.bytes                 lfs

# -------------------------------------------------------------
# フォント
# -------------------------------------------------------------
*.ttc                   lfs
*.woff                  lfs
*.woff2                 lfs

# -------------------------------------------------------------
# 追加のビルド成果物
#   ※ .gitignore 側で無視しているため通常は無効。
#     git add -f で意図的に追跡した場合のみ効く保険。
# -------------------------------------------------------------
*.aab                   lfs
*.ipa                   lfs

# -------------------------------------------------------------
# Inference Engine (旧 Sentis) のモデルファイル
# -------------------------------------------------------------
*.onnx                  lfs
*.sentis                lfs

# -------------------------------------------------------------
# Unity YAML アセットの追加分（テンプレート未収録）
#   VFX Graph とそのサブグラフは Unity YAML。
#   unityyamlmerge を効かせないと、コンフリクト時に
#   手作業でのマージが事実上不可能になる。
# -------------------------------------------------------------
*.vfx                   unity-yaml
*.vfxoperator           unity-yaml
*.vfxblock              unity-yaml

# -------------------------------------------------------------
# テキストファイルの改行コード統一
# -------------------------------------------------------------
*.md                    text eol=lf
*.txt                   text eol=lf
*.json                  text eol=lf
*.jsonc                 text eol=lf
*.xml                   text eol=lf
*.yml                   text eol=lf
*.yaml                  text eol=lf
*.rsp                   text eol=lf

# ドットファイルは *.xxx ではなく実名で指定する
# （*.gitignore でも一応マッチするが意図が読み取りづらい）
.editorconfig           text eol=lf
.gitignore              text eol=lf
.gitattributes          text eol=lf
.gitmodules             text eol=lf

# ソースコードも LF に固定する
#   テンプレートは `text` のみで eol 未指定のため、
#   core.autocrlf の設定次第で Windows 側だけ CRLF になり
#   人によって差分が出る。ここで上書きして統一する。
#   （既存の diff=csharp 等の属性は明示的に引き継いでいる）
*.cs                    text diff=csharp eol=lf
*.cginc                 text eol=lf
*.compute               text linguist-language=hlsl eol=lf
*.hlsl                  text linguist-language=hlsl eol=lf
*.raytrace              text linguist-language=hlsl eol=lf
*.shader                text eol=lf
*.tss                   text diff=css linguist-language=css eol=lf
*.uss                   text diff=css linguist-language=css eol=lf
*.uxml                  text linguist-language=xml linguist-detectable eol=lf

# Windows 専用スクリプトのみ CRLF
*.bat                   text eol=crlf
*.cmd                   text eol=crlf
*.ps1                   text eol=crlf
*.sh                    text eol=lf

# -------------------------------------------------------------
# バイナリ形式で保存される .asset 系（unity-yaml を打ち消す）
#   テンプレート末尾の LightingData.asset と同じ扱い。
#   binary = -diff -merge -text であり LFS 化ではないため、
#   NavMesh が肥大化するプロジェクトでは
#   `NavMesh.asset lfs` への変更も検討すること。
# -------------------------------------------------------------
NavMesh.asset           binary
